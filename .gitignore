# Secrets — never commit
.env
*.pem
*service_account*.json

# Extracted data — never commit business data
data/
data_sample/
export/
*.duckdb
*.parquet
*.csv

# App runtime state — lock file, run history, live log (app/pages/1_Pipeline.py)
app_state/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Journaux d'exécution
*.log

# Artefacts de compilation LaTeX (rapport.tex et rapport.pdf sont conservés)
rapport/*.aux
rapport/*.fdb_latexmk
rapport/*.fls
rapport/*.out
rapport/*.toc
rapport/*.synctex.gz
