# --- Backfill credentials -------------------------------------------------
# The backfill reads these first. If they are absent it falls back to
# META_ACCESS_TOKEN / META_AD_ACCOUNT_ID, so an existing .env keeps working.
#
# Use a System User token from Business Manager: it does not expire, which
# matters for a multi-hour extraction. A Graph API Explorer token lasts ~1h
# and will die mid-run.
META_BACKFILL_TOKEN=
META_BACKFILL_ACCOUNT_ID=act_000000000000000

# --- Optional -------------------------------------------------------------
META_API_VERSION=v19.0
BACKFILL_DATA_DIR=data
